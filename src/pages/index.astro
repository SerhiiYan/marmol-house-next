---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro'; 
import FeaturedProjects from '../components/FeaturedProjects.astro';
import WhyUsGrid from '../components/WhyUsGrid.astro';
import GeneralPricing from '../components/GeneralPricing.jsx'; 
import GoogleReviews from '../components/GoogleReviews.astro';

const REAL_RATING = "5.0"; 
const REAL_REVIEW_COUNT = "12"; 

const combinedSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': 'Marmol House',
  'image': 'https://marmolhouse.by/og-image.png',
  'description': 'Строительство каркасных и блочных домов под ключ в Гродно и по всей Беларуси. Работаем по Указу №95 для многодетных семей и жителей пригорода.',
  'url': 'https://marmolhouse.by',
  'logo': 'https://marmolhouse.by/logo-bg.png',
  'telephone': '+375291845481',
  'priceRange': '$$ - $$$',
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': 'г. Гродно, ул. Лелевеля, 12A, к 6',
    'addressLocality': 'Гродно',
    'addressCountry': 'BY',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 53.6784,
    'longitude': 23.8295,
  },
  'openingHoursSpecification': [{
    '@type': 'OpeningHoursSpecification',
    'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    'opens': '09:00',
    'closes': '18:00',
  }],
  'sameAs': ['https://www.instagram.com/marmol_house/'],
  'aggregateRating': {
    '@type': 'AggregateRating',
    'ratingValue': REAL_RATING, 
    'reviewCount': REAL_REVIEW_COUNT, 
  }
};

// SEO-данные конкретно для главной
const pageTitle = "Строительство домов в Гродно и Минске под ключ | Marmol House";
const pageDescription = "Архитектурное проектирование и строительство современных каркасных и блочных домов. Фиксированная смета, гарантия качества, помощь с кредитами (Указ №95).";
---

{/* Передаем всё красиво через параметры нашего умного Layout */}
<Layout title={pageTitle} description={pageDescription} schema={combinedSchema}>
    <main>
        <Hero /> 
        <FeaturedProjects />
        <WhyUsGrid />
        <GeneralPricing client:visible />
        <GoogleReviews />
    </main>
</Layout>