---
// src/components/ui/CookieBanner.astro
---

<div 
    id="cookie-banner" 
    class="fixed bottom-4 left-4 right-4 md:left-auto md:right-8 md:w-[480px] bg-marmol-navy text-white p-6 rounded-2xl shadow-2xl z-[100] hidden translate-y-10 opacity-0 transition-all duration-500 border border-white/10"
>
    <div class="flex flex-col gap-4">
        <div>
            <h4 class="text-sm font-bold uppercase tracking-widest text-marmol-gold mb-2">Использование Cookie</h4>
            <p class="text-xs text-gray-300 leading-relaxed">
                Мы используем файлы cookie для анализа трафика и улучшения работы сайта. 
                Оставаясь с нами, вы даете согласие на их сбор. Вы можете отказаться, но некоторые функции сайта могут работать хуже. 
                Подробнее в <a href="/privacy" class="text-white underline hover:text-marmol-gold transition-colors">Политике конфиденциальности</a>.
            </p>
        </div>
        
        <div class="flex items-center gap-3 mt-2">
            <button 
                id="btn-accept-cookies" 
                class="flex-1 bg-marmol-gold text-marmol-navy font-bold uppercase tracking-widest text-[10px] md:text-xs py-3 rounded-lg hover:bg-white transition-colors"
            >
                Принять все
            </button>
            <button 
                id="btn-decline-cookies" 
                class="flex-1 bg-transparent border border-gray-500 text-gray-300 font-bold uppercase tracking-widest text-[10px] md:text-xs py-3 rounded-lg hover:border-white hover:text-white transition-colors"
            >
                Отказаться
            </button>
        </div>
    </div>
</div>

<script is:inline>
    // 1. ИНИЦИАЛИЗАЦИЯ GOOGLE CONSENT MODE (Выполняется сразу!)
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    
    // По умолчанию запрещаем куки до согласия
    gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied'
    });
    const GA_ID = 'G-KNB082B9WE';
    const gaScript = document.createElement('script');
    gaScript.async = true;
    gaScript.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(gaScript);
    
    gtag('js', new Date());
    gtag('config', GA_ID);
    document.addEventListener('astro:page-load', () => {
        const banner = document.getElementById('cookie-banner');
        const btnAccept = document.getElementById('btn-accept-cookies');
        const btnDecline = document.getElementById('btn-decline-cookies');
        const STORAGE_KEY = 'marmol_cookie_consent';
        const YM_ID = 104396711;

        const loadYandexMetrika = () => {
            if (window.ym) return; // Защита от двойной загрузки
            (function(m,e,t,r,i,k,a){
                m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
                m[i].l=1*new Date();
                for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
                k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
            })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

            ym(YM_ID, 'init', {
                clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true
            });
        };

        const grantConsent = () => {
            // Обновляем статус в Google Analytics (теперь можно использовать куки)
            gtag('consent', 'update', {
                'ad_storage': 'granted',
                'analytics_storage': 'granted',
                'ad_user_data': 'granted',
                'ad_personalization': 'granted'
            });
            // Загружаем Яндекс.Метрику
            loadYandexMetrika();
        };

        const consent = localStorage.getItem(STORAGE_KEY);

        if (consent === 'accepted') {
            grantConsent();
        } else if (consent === null && banner) {
            banner.classList.remove('hidden');
            setTimeout(() => {
                banner.classList.remove('translate-y-10', 'opacity-0');
            }, 100);
        }

        const closeBanner = () => {
            if (!banner) return;
            banner.classList.add('translate-y-10', 'opacity-0');
            setTimeout(() => banner.classList.add('hidden'), 500); 
        };

        btnAccept?.addEventListener('click', () => {
            localStorage.setItem(STORAGE_KEY, 'accepted');
            grantConsent();
            closeBanner();
        });

        btnDecline?.addEventListener('click', () => {
            localStorage.setItem(STORAGE_KEY, 'declined');
            closeBanner();
        });
    });
</script>