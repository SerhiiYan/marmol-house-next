---
// src/components/Header.astro
import Logo from './ui/Logo.astro';

// Этот массив можно использовать в будущем для автоматизации рендера, 
// но пока оставляем жесткую верстку для сложного мега-меню
const links = [
  { name: 'Проекты', href: '/projects' },
  { name: 'Портфолио', href: '/portfolio' }, 
  { name: 'Блог', href: '/blog' },
  { name: 'Контакты', href: '/contact' }, 
  { name: 'О компании', href: '/about' },
];
---
<header class="fixed top-0 left-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-gray-100/50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-24">
      
      <div class="flex-shrink-0 z-50 relative">
        <Logo variant="light" />
      </div>

      <nav class="hidden md:flex space-x-8 items-center h-full">
        
        <a href="/projects" class="font-sans text-xs lg:text-sm font-semibold uppercase tracking-wider text-marmol-navy hover:text-marmol-gold transition-colors duration-300">
          Проекты
        </a>

        <a href="/portfolio" class="font-sans text-xs lg:text-sm font-semibold uppercase tracking-wider text-marmol-navy hover:text-marmol-gold transition-colors duration-300">
          Портфолио
        </a>

        <a href="/real-estate" class="font-sans text-xs lg:text-sm font-bold uppercase tracking-wider text-marmol-gold hover:text-marmol-navy transition-colors duration-300">
          Готовые дома
        </a>

        <div class="group h-full flex items-center relative">
            <button class="font-sans text-xs lg:text-sm font-semibold uppercase tracking-wider text-marmol-navy group-hover:text-marmol-gold transition-colors duration-300 flex items-center cursor-default h-full py-8">
                Услуги
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 ml-1 group-hover:rotate-180 transition-transform duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
            </button>

            <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%-1px)] w-[800px] bg-white border border-gray-100 shadow-xl rounded-b-xl opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300 ease-out pointer-events-none group-hover:pointer-events-auto overflow-hidden">
                <div class="grid grid-cols-12 p-8 gap-6">
                    
                    <div class="col-span-4 border-r border-gray-100 pr-6">
                        <h3 class="text-marmol-gold font-bold uppercase tracking-widest text-xs mb-4">Строительство</h3>
                        <ul class="space-y-3">
                            <li><a href="/services/frame-houses" class="block text-marmol-navy hover:text-marmol-gold transition-colors text-sm">Каркасные дома</a></li>
                            <li><a href="/services/gas-silicate-houses" class="block text-marmol-navy hover:text-marmol-gold transition-colors text-sm">Блочные дома</a></li>
                            <li><a href="/services/business" class="block text-marmol-navy hover:text-marmol-gold transition-colors text-sm">Для бизнеса</a></li>
                            <li><a href="/services/facades" class="block text-marmol-navy hover:text-marmol-gold transition-colors text-sm">Премиум фасады</a></li>
                        </ul>
                    </div>

                    <div class="col-span-4 border-r border-gray-100 pr-6 flex flex-col gap-6">
                        <!-- Блок Подготовки -->
                        <div>
                            <h3 class="text-marmol-gold font-bold uppercase tracking-widest text-xs mb-4">Подготовка</h3>
                            <ul class="space-y-3">
                                <li><a href="/services/design" class="block text-marmol-navy hover:text-marmol-gold transition-colors text-sm">Проектирование</a></li>
                            </ul>
                        </div>
                        
                        <!-- Блок Процесса (Live-стройка) -->
                        <div>
                            <h3 class="text-marmol-gold font-bold uppercase tracking-widest text-xs mb-4">Процесс</h3>
                            <ul class="space-y-3">
                                <li>
                                    <a href="/diary" class="inline-flex items-center text-marmol-navy hover:text-marmol-gold transition-colors text-sm relative">
                                        Live-стройка
                                        <!-- Пульсирующий индикатор -->
                                        <span class="absolute -right-4 top-1 flex h-2 w-2">
                                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-span-4 flex flex-col justify-between">
                        <div class="mt-6 bg-gray-50 border border-gray-100 rounded-lg p-4 hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between mb-1">
                                <h4 class="font-sans font-bold text-marmol-navy text-sm">Карта строек</h4>
                                <!-- Пульсирующий индикатор Live -->
                                <span class="relative flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                                </span>
                            </div>
                            <p class="text-gray-500 text-[11px] mb-3 leading-tight">Следите за этапами строительства на наших объектах в реальном времени.</p>
                            <a href="/live" class="text-marmol-gold font-bold uppercase tracking-wider text-[10px] border-b border-marmol-gold/30 hover:border-marmol-gold pb-0.5 transition-colors inline-block">
                                Смотреть объекты →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <a href="/blog" class="font-sans text-xs lg:text-sm font-semibold uppercase tracking-wider text-marmol-navy hover:text-marmol-gold transition-colors duration-300">
          Блог
        </a>

        <a href="/about" class="font-sans text-xs lg:text-sm font-semibold uppercase tracking-wider text-marmol-navy hover:text-marmol-gold transition-colors duration-300">
          О компании
        </a>

      </nav>

      <div class="hidden md:flex items-center space-x-6">
        <div class="flex flex-col items-end">
            <a href="tel:+375291845481" class="font-body font-bold text-marmol-navy hover:text-marmol-gold transition-colors text-sm whitespace-nowrap leading-none">
              +375 (29) 184-54-81
            </a>
            <a href="/contact" class="text-[10px] text-gray-400 font-medium mt-1 hover:text-marmol-gold transition-colors">
                г. Гродно, ул. Лелевеля, 12A
            </a>
        </div>
      </div>

      <button id="mobile-menu-btn" aria-label="Открыть мобильное меню" class="md:hidden text-marmol-navy p-2 focus:outline-none cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden fixed top-24 left-0 w-full h-[calc(100dvh-6rem)] bg-white border-t border-gray-100 shadow-xl overflow-y-auto pb-10">
    <div class="flex flex-col p-6 space-y-5">
        
        <a href="/projects" class="text-xl font-sans font-bold text-marmol-navy border-b border-gray-50 pb-2">Проекты</a>
        <a href="/portfolio" class="text-xl font-sans font-bold text-marmol-navy border-b border-gray-50 pb-2">Портфолио</a>
        <a href="/real-estate" class="text-xl font-sans font-bold text-marmol-gold border-b border-gray-50 pb-2">Готовые дома</a>
        
        <div>
            <div class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-3">Строительство</div>
            <div class="flex flex-col space-y-3 pl-4 border-l-2 border-gray-100">
                <a href="/services/frame-houses" class="text-base text-gray-700 font-medium">Каркасные дома</a>
                <a href="/services/gas-silicate-houses" class="text-base text-gray-700 font-medium">Блочные дома</a>
                <a href="/services/business" class="text-base text-gray-700 font-medium">Для бизнеса</a>
                <a href="/services/facades" class="text-base text-gray-700 font-medium">Премиум фасады</a>
            </div>

            <!-- Подготовка -->
            <div class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-3 mt-6">Подготовка</div>
            <div class="flex flex-col space-y-3 pl-4 border-l-2 border-gray-100">
                <a href="/services/design" class="text-base text-gray-700 font-medium">Проектирование</a>
            </div>

            <!-- Процесс (Live-стройка) -->
            <div class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-3 mt-6">Процесс</div>

            <!-- 1. Твоя оригинальная ссылка никуда не девается -->
            <div class="flex flex-col space-y-3 pl-4 border-l-2 border-gray-100 mb-4">
                <a href="/diary" class="text-base text-gray-700 font-medium flex items-center gap-2">
                    Дневник стройки
                </a>
            </div>

            <!-- 2. И под ней добавляем новую страницу с картой -->
            <a href="/live" class="relative bg-gray-50 border border-gray-100 rounded-xl p-4 flex items-center justify-between overflow-hidden">
                <div class="absolute inset-0 opacity-[0.04]" 
                     style="background-image: radial-gradient(#1e293b 1px, transparent 1px); background-size: 16px 16px;">
                </div>

                <div class="relative z-10">
                    <span class="text-base font-bold text-marmol-navy block mb-0.5">Карта строек</span>
                    <span class="text-[11px] text-gray-500 block">Объекты в реальном времени</span>
                </div>

                <div class="relative z-10 flex flex-col items-center gap-1">
                    <div class="flex items-center justify-center bg-white border border-gray-100 w-8 h-8 rounded-full shadow-sm">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                        </span>
                    </div>
                </div>
            </a>

        </div>
        
        <div class="h-[1px] bg-gray-100 w-full my-2"></div>
        
        <a href="/about" class="text-lg font-sans font-medium text-marmol-navy">О компании</a>
        <a href="/blog" class="text-lg font-sans font-medium text-marmol-navy">Блог</a>
        <a href="/contact" class="text-lg font-sans font-medium text-marmol-navy">Контакты</a>

        <div class="pt-4 mt-2 border-t border-gray-50">
             <a href="tel:+375291845481" class="text-2xl font-bold text-marmol-navy block mb-1">+375 (29) 184-54-81</a>
             <a href="/contact" class="text-sm text-gray-500 block mb-2">г. Гродно, ул. Лелевеля, 12A, к 6</a>
             <p class="text-xs text-gray-400">Ежедневно с 9:00 до 18:00</p>
             
             <button id="mobile-meeting-btn" class="mt-6 w-full py-4 bg-marmol-navy text-white text-xs font-bold uppercase tracking-widest rounded-sm hover:bg-marmol-gold transition-colors">
                Записаться на встречу
             </button>
        </div>
    </div>
  </div>
</header>

<script>
    import { isModalOpen, formComment } from '../store/modalStore';

    // 1. Выносим логику наружу, чтобы ссылки на функции были постоянными!
    const toggleMenu = () => {
        const menu = document.getElementById('mobile-menu');
        menu?.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden');
    };

    const handleModalClicks = (e: Event) => {
        // Убеждаемся, что e.target существует и является HTML-элементом
        if (!(e.target instanceof Element)) return;

        const isDesktopBtn = e.target.closest('#menu-meeting-btn');
        const isMobileBtn = e.target.closest('#mobile-meeting-btn');
        
        if (isDesktopBtn || isMobileBtn) {
            formComment.set('Здравствуйте! Хочу записаться на встречу в офисе для консультации.');
            isModalOpen.set(true);
            
            const menu = document.getElementById('mobile-menu');
            if (menu && !menu.classList.contains('hidden')) {
                menu.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }
    };

    function initHeader() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');

        // Теперь удаление сработает идеально
        btn?.removeEventListener('click', toggleMenu);
        btn?.addEventListener('click', toggleMenu);

        const mobileLinks = menu?.querySelectorAll('a');
        mobileLinks?.forEach(link => {
            // Клонировать узел не будем, просто чистим обработчики через именованную функцию или забиваем (для 'a' это не критично)
            link.addEventListener('click', () => {
                menu?.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }, { once: true }); // срабатывает 1 раз, предотвращает утечки
        });

        document.removeEventListener('click', handleModalClicks);
        document.addEventListener('click', handleModalClicks);
    }

    // astro:page-load сам сработает при первой загрузке. Ручной вызов initHeader() удален.
    document.addEventListener('astro:page-load', initHeader);
</script>